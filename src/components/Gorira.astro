---
import goriraImg from "../assets/gorira.png";
---

<style>
  div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 40px;
    picture {
      img {
        width: 100%;
        height: 100%;
      }
    }
    p {
      font-size: 12px;
      letter-spacing: 3px;
    }
  }
</style>

<div>
  <picture>
    <img src={goriraImg.src} alt="">
  </picture>
  <p><span>1</span>/3</p>
</div>