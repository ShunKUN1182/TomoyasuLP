---
import goriraImg from "../assets/gorira.png";
---

<style>
  div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin: 34px auto 0;
    width: 178px;
    min-height: 154px;
    padding: 24px 24px 14px;
    background:
      linear-gradient(var(--color-paper), var(--color-paper)) padding-box,
      repeating-linear-gradient(90deg, #c8b69e 0 18px, #ddcfbc 18px 21px) border-box;
    border: 15px solid transparent;
    border-bottom: 0;
    border-radius: 96px 96px 0 0;
    picture {
      width: 92px;
      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }
    p {
      min-width: 64px;
      padding: 4px 12px;
      border-radius: 999px;
      background: #c5ad91;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 1px;
      text-align: center;
    }
  }
</style>

<div>
  <picture>
    <img src={goriraImg.src} alt="">
  </picture>
  <p><span>1</span>/3</p>
</div>
