---
import curtainhooks from "../assets/CurtainHooks.png";
import doubleStone from "../assets/double_stone.png";
---

<style>
  .itemIntroduction {
    position: relative;
    margin-top: 170px;
    padding: 86px 24px 58px;
    background-color: #d4d9d3;
  }

  .itemIntroduction__heading {
    position: absolute;
    top: -73px;
    right: 0;
    padding: 0 8px 8px 12px;
    border-bottom: 10px solid #d4d9d3;
  }

  .itemIntroduction__title {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .itemIntroduction__title h2 {
    color: #b4bfb1;
    font-family: serif;
    font-size: 32px;
    line-height: 1;
  }

  .itemIntroduction__title img {
    width: 40px;
    height: auto;
    object-fit: contain;
  }

  .itemIntroduction__hook {
    position: absolute;
    top: -52px;
    left: -8px;
    width: 112px;
    height: auto;
    transform: rotate(-4deg);
  }

  .itemIntroduction__card {
    display: grid;
    gap: 22px;
    max-width: 520px;
    margin: 0 auto;
    padding: 24px 22px 28px;
    background-color: rgba(255, 255, 255, 0.64);
    border-radius: 20px;
  }

  .itemIntroduction__image {
    display: grid;
    place-items: center;
    min-height: 210px;
  }

  .itemIntroduction__image img {
    width: 150px;
    height: auto;
    filter: drop-shadow(0 12px 12px rgba(68, 79, 64, 0.18));
  }

  .itemIntroduction__body {
    display: grid;
    gap: 13px;
    color: #374033;
  }

  .itemIntroduction__eyebrow {
    color: #859d7c;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.08em;
  }

  .itemIntroduction__body h3 {
    font-size: 22px;
    line-height: 1.45;
  }

  .itemIntroduction__body p {
    font-size: 13px;
    line-height: 1.9;
  }

  .itemIntroduction__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    min-width: 142px;
    min-height: 38px;
    padding: 8px 20px;
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.04em;
    background-color: #859d7c;
    border-radius: 999px;
  }

  @media (min-width: 768px) {
    .itemIntroduction {
      margin-top: 190px;
      padding: 96px 40px 70px;
    }

    .itemIntroduction__heading {
      right: calc(50% - 330px);
    }

    .itemIntroduction__hook {
      left: calc(50% - 330px);
      width: 132px;
    }

    .itemIntroduction__card {
      grid-template-columns: 210px 1fr;
      align-items: center;
      max-width: 660px;
      min-height: 360px;
      padding: 34px;
    }

    .itemIntroduction__image {
      min-height: 260px;
    }

    .itemIntroduction__image img {
      width: 172px;
    }
  }
</style>

<section class="itemIntroduction" aria-labelledby="item-introduction-title">
  <div class="itemIntroduction__heading">
    <div class="itemIntroduction__title">
      <h2 id="item-introduction-title">DIYスタイル</h2>
      <img src={doubleStone.src} alt="" aria-hidden="true" />
    </div>
  </div>

  <img class="itemIntroduction__hook" src={curtainhooks.src} alt="" aria-hidden="true" />

  <div class="itemIntroduction__card">
    <picture class="itemIntroduction__image">
      <img src={curtainhooks.src} alt="アンティーク調のカーテンフック" />
    </picture>

    <div class="itemIntroduction__body">
      <span class="itemIntroduction__eyebrow">PICK UP ITEM</span>
      <h3>部屋づくりを楽しむ<br />小さなアクセント</h3>
      <p>
        窓辺や壁面に取り入れるだけで、空間の印象をやわらかく変えてくれるカーテンフック。DIYスタイルの家具や雑貨とも合わせやすい、暮らしになじむアイテムです。
      </p>
      <a class="itemIntroduction__button" href="/diagnosis">診断してみる</a>
    </div>
  </div>
</section>
