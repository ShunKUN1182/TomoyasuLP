---
import curtainhooks from "../assets/CurtainHooks.png";

const {
  title,
  lead,
  images,
  decoImg,
  accentImg,
  variant = "default",
} = Astro.props;
---

<style>
  .item_wrap {
    position: relative;
    margin-top: 124px;
    padding: 57px 14px 28px;
    min-height: 548px;
    background-color: #D4D9D3;
    &:first-child {
      margin-top: 0;
    }
    .head_text {
      position: absolute;
      top: -56px;
      right: 0;
      width: min(75%, 308px);
      padding: 0 0 0 28px;
      border-bottom: 10px solid #d4d9d3;
      div {
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        gap: 8px;
        h2 {
          color: #b6c0b2;
          font-size: 30px;
          font-weight: 700;
          line-height: 1;
          letter-spacing: 0;
          white-space: nowrap;
        }
        img {
          object-fit: contain;
          width: 34px;
          margin-bottom: -5px;
        }
      }
    }
    .hooks {
      position: absolute;
      top: -40px;
      left: -11px;
      width: 50px;
      height: auto;
      z-index: 2;
    }
    .img_wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 2fr 1.27fr;
      gap: 10px;
      margin: 0 auto;
      min-height: 405px;
      padding: 14px;
      background-color: var(--color-card);
      border-radius: 16px;
      box-shadow: var(--shadow-soft);
      img {
        width: 100%;
        height: 100%;
        min-height: 0;
        border-radius: 12px;
        object-fit: cover;
      }
      img:first-child {
        grid-column: 1 / -1;
      }
    }
    .caption {
      margin: 27px -14px 0;
      padding: 8px 22px;
      background: rgba(255, 255, 255, 0.76);
      color: #a19482;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.5;
      text-align: center;
      box-shadow:
        inset 0 1px 0 rgba(161, 148, 130, 0.18),
        inset 0 -1px 0 rgba(161, 148, 130, 0.18);
    }
  }

  .item_wrap[data-variant="diy"] .head_text {
    right: 0;
    width: min(61%, 244px);
    padding-right: 4px;
  }

  .item_wrap[data-variant="aras"] .head_text {
    right: 0;
    width: min(54%, 232px);
    padding-right: 22px;
  }

  .item_wrap[data-variant="aras"] .head_text::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -6px;
    width: 46px;
    height: 46px;
    background: var(--accent-img) center / contain no-repeat;
    transform: rotate(-24deg);
  }

  .item_wrap[data-variant="lantern"] .head_text {
    right: 0;
    width: min(58%, 250px);
    padding-right: 36px;
  }

  .item_wrap[data-variant="lantern"] .head_text::after {
    content: "";
    position: absolute;
    right: 4px;
    bottom: -10px;
    width: 24px;
    height: 62px;
    background: var(--accent-img) center / cover no-repeat;
  }
</style>

<section
  class="item_wrap"
  data-variant={variant}
  style={`--accent-img: ${accentImg ? `url(${accentImg.src})` : "none"}`}
>
  <div class="head_text">
    <div>
      <h2>{title}</h2>
      {decoImg && <img src={decoImg.src} alt="">}
    </div>
  </div>
  <img src={curtainhooks.src} alt="" class="hooks">
  <div class="img_wrap">
    {images.map((image) => <img src={image.src} alt="">)}
  </div>
  <p class="caption">{lead}</p>
</section>
