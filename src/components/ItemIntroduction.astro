---
import curtainhooks from "../assets/CurtainHooks.png";
import double_stone from "../assets/double_stone.png";
import diyMain from "../assets/mainvisual_img03.png";
import arasMain from "../assets/mainVisual_img02.png";
import lanternMain from "../assets/mainvisual_img01.png";
import pickupDiy from "../assets/pickup_items_img01.png";
import pickupAras from "../assets/pickup_items_img02.png";
import pickupLantern from "../assets/pickup_items_img03.png";

const sections = [
  {
    title: "DIYスタイル",
    lead: "美濃焼風のDIYタイルシール",
    deco: double_stone,
    images: [diyMain, pickupDiy, pickupAras],
  },
  {
    title: "ARAS",
    lead: "軽くて割れない食器・カトラリー ARAS 深皿スクープ",
    images: [arasMain, pickupAras, diyMain],
  },
  {
    title: "ランタン",
    lead: "天然木×マットブラックの異素材デザイン",
    images: [lanternMain, pickupLantern, pickupDiy],
  },
];
---

<style>
  .items {
    padding-top: 142px;
  }

  .item_wrap {
    position: relative;
    margin-top: 124px;
    padding: 57px 14px 28px;
    min-height: 548px;
    background-color: #D4D9D3;
    &:first-child {
      margin-top: 0;
    }
    .head_text {
      position: absolute;
      top: -56px;
      right: 10px;
      width: min(78%, 330px);
      padding: 0 8px 0 28px;
      border-bottom: 10px solid #d4d9d3;
      div {
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        gap: 8px;
        h2 {
          color: #b6c0b2;
          font-size: 30px;
          font-weight: 700;
          line-height: 1;
          white-space: nowrap;
        }
        img {
          object-fit: contain;
          width: 34px;
          margin-bottom: -5px;
        }
      }
    }
    .hooks {
      position: absolute;
      top: -40px;
      left: -11px;
      width: 50px;
      height: auto;
      z-index: 2;
    }
    .img_wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 2fr 1.27fr;
      gap: 10px;
      margin: 0 auto;
      min-height: 405px;
      padding: 14px;
      background-color: var(--color-card);
      border-radius: 16px;
      box-shadow: var(--shadow-soft);
      img {
        width: 100%;
        height: 100%;
        min-height: 0;
        border-radius: 12px;
        object-fit: cover;
      }
      img:first-child {
        grid-column: 1 / -1;
      }
    }
    .caption {
      margin: 27px -14px 0;
      padding: 8px 22px;
      background: rgba(255, 255, 255, 0.76);
      color: #a19482;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.5;
      text-align: center;
      box-shadow:
        inset 0 1px 0 rgba(161, 148, 130, 0.18),
        inset 0 -1px 0 rgba(161, 148, 130, 0.18);
    }
  }

  .item_wrap:nth-child(2) .head_text {
    right: 4px;
  }

  .item_wrap:nth-child(2) .head_text::after {
    content: "";
    position: absolute;
    right: 5px;
    bottom: -6px;
    width: 46px;
    height: 46px;
    background: url("../assets/forkAndSpun.png") center / contain no-repeat;
    transform: rotate(-24deg);
  }

  .item_wrap:nth-child(3) .head_text {
    right: 20px;
    width: min(58%, 250px);
  }

  .item_wrap:nth-child(3) .head_text::after {
    content: "";
    position: absolute;
    right: -27px;
    bottom: -10px;
    width: 24px;
    height: 62px;
    background: url("../assets/mainvisual_img01.png") center / cover no-repeat;
  }
</style>

<div class="items">
  {sections.map((section) => (
    <section class="item_wrap">
      <div class="head_text">
        <div>
          <h2>{section.title}</h2>
          {section.deco && <img src={section.deco.src} alt="">}
        </div>
      </div>
      <img src={curtainhooks.src} alt="" class="hooks">
      <div class="img_wrap">
        {section.images.map((image) => <img src={image.src} alt="">)}
      </div>
      <p class="caption">{section.lead}</p>
    </section>
  ))}
</div>
