---
import mainVisualImg01 from "../assets/mainvisual_img01.png";
import mainVisualImg02 from "../assets/mainvisual_img02.png";
import mainVisualImg03 from "../assets/mainvisual_img03.png";
import circleStone from "../assets/circle_stone.png";
import forkAndSpun from "../assets/forkAndSpun.png";
---

<style define:vars={{
  forkAndSpun: `url(${forkAndSpun.src})`,
  circleStone: `url(${circleStone.src})`,
}}>
.mainvisual {
  height: 600px;
  width: 100vw;
  /* background-color: tomato; */
  display: flex;
  align-items: center;
  justify-content: flex-start;
  h1 {
    margin-left: 12px;
    font-size: 32px;
    font-weight: bold;
    font-family: serif;
  }
  .mainVisualImg {
    position: absolute;
    border-radius: 100%;
    img {
      width: 100%;
      height: 100%;
      border-radius: 100%;
    }
  }
  .mainVisualImg01 {
    top: -30px;
    left: -30px;
    width: 270px;
    height: 270px;
    box-shadow: 0 4px 25px 0 #FFF inset;
    filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.25));
    &::after {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 100%;
      top: 0;
      left: 0;
      background: radial-gradient(transparent 99%,#FDFFE2 100%);
      animation: light 3s infinite linear;
    }
  }
  .mainVisualImg02 {
    right: -20px;
    width: 200px;
    height: 200px;
    &::after {
      content: "";
      position: absolute;
      bottom: -50px;
      right: -2px;
      background-image: var(--forkAndSpun);
      background-position: center;
      background-size: 80px;
      background-repeat: no-repeat;
      width: 100px;
      height: 100px;
    }
  }
  .mainVisualImg03 {
    top: 400px;
    left: 20px;
    width: 200px;
    height: 200px;
    overflow: visible;
    &::after {
      content: "";
      position: absolute;
      top: -20px;
      left: -20px;
      /* background-color: tomato; */
      background-image: var(--circleStone);
      background-position: center;
      background-size: 240px;
      background-repeat: no-repeat;
      height: 120%;
      width: 120%;
      animation: rotate 25s infinite linear;
    }
  }
}

@keyframes rotate {
  0% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(180deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
@keyframes light {
  0% {
    background: radial-gradient(transparent 99%,#FDFFE2 100%);
  }
  50% {
    background: radial-gradient(transparent 45%,#FDFFE2 100%);
  }
  100% {
    background: radial-gradient(transparent 99%,#FDFFE2 100%);
  }
}

</style>

<div class="mainvisual">
  <h1>Colors 台湾</h1>
  <picture class="mainVisualImg mainVisualImg01">
    <img src={mainVisualImg01.src} alt="">
  </picture>
  <picture class="mainVisualImg mainVisualImg02">
    <img src={mainVisualImg02.src} alt="">
  </picture>
  <picture class="mainVisualImg mainVisualImg03">
    <img src={mainVisualImg03.src} alt="">
  </picture>

</div>