---
import mainVisualImg01 from "../assets/mainvisual_img01.png";
import mainVisualImg02 from "../assets/mainvisual_img02.png";
import mainVisualImg03 from "../assets/mainvisual_img03.png";
import circleStone from "../assets/circle_stone.png";
import forkAndSpun from "../assets/forkAndSpun.png";
---

<style define:vars={{
  forkAndSpun: `url(${forkAndSpun.src})`,
  circleStone: `url(${circleStone.src})`,
}}>
.mainvisual {
  position: relative;
  height: 670px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  isolation: isolate;
  h1 {
    position: relative;
    z-index: 3;
    margin: 82px 0 0 14px;
    font-size: clamp(28px, 8vw, 34px);
    font-weight: bold;
    font-family: Georgia, "Times New Roman", "Yu Mincho", serif;
    line-height: 1;
    letter-spacing: 0;
    text-shadow: 0 2px 0 rgba(255, 255, 255, 0.75);
  }
  .mainVisualImg {
    position: absolute;
    border-radius: 100%;
    overflow: hidden;
    z-index: 1;
    img {
      width: 100%;
      height: 100%;
      border-radius: 100%;
      object-fit: cover;
    }
  }
  .mainVisualImg01 {
    top: -28px;
    left: -42px;
    width: 292px;
    height: 292px;
    box-shadow: 0 4px 25px 0 #FFF inset;
    filter: drop-shadow(0 4px 4px rgba(0, 0, 0, 0.25));
    &::after {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 100%;
      top: 0;
      left: 0;
      background: radial-gradient(transparent 45%,#FDFFE2 100%);
      animation: light 2s infinite;
    }
    &::before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 100%;
      top: 0;
      left: 0;
      background: radial-gradient(transparent 45%,#FDFFE2 100%);
    }

  }
  .mainVisualImg02 {
    top: 156px;
    right: -18px;
    width: 188px;
    height: 188px;
    box-shadow: var(--shadow-soft);
    &::after {
      content: "";
      position: absolute;
      bottom: -50px;
      right: -2px;
      background-image: var(--forkAndSpun);
      background-position: center;
      background-size: 80px;
      background-repeat: no-repeat;
      width: 100px;
      height: 100px;
    }
  }
  .mainVisualImg03 {
    top: 348px;
    left: 24px;
    width: 214px;
    height: 214px;
    overflow: visible;
    &::after {
      content: "";
      position: absolute;
      top: -20px;
      left: -20px;
      /* background-color: tomato; */
      background-image: var(--circleStone);
      background-position: center;
      background-size: 258px;
      background-repeat: no-repeat;
      height: 120%;
      width: 120%;
      animation: rotate 25s infinite linear;
      z-index: -1;
    }
  }
}

@keyframes rotate {
  0% {
    transform: rotate(0deg);
  }
  50% {
    transform: rotate(180deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
@keyframes light {
  0% {
      transform: scale(100%,100%);
  }
  50% {
      transform: scale(110%,110%);
  }
  100% {
      transform: scale(100%,100%);
  }
}

</style>

<div class="mainvisual">
  <h1>Colors 台湾</h1>
  <picture class="mainVisualImg mainVisualImg01">
    <img src={mainVisualImg01.src} alt="">
  </picture>
  <picture class="mainVisualImg mainVisualImg02">
    <img src={mainVisualImg02.src} alt="">
  </picture>
  <picture class="mainVisualImg mainVisualImg03">
    <img src={mainVisualImg03.src} alt="">
  </picture>

</div>
