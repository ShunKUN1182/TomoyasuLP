---
const {imgPath,title} = Astro.props;
---

<style>
    div {
    display: flex;
    flex-direction: column;
    gap: 9px;
    justify-content: center;
    align-items: center;
    flex: 1;
    min-width: 0;
    img {
      width: 66px;
      height: 66px;
      border-radius: 50%;
      object-fit: cover;
      box-shadow: 0 4px 12px rgba(49, 43, 42, 0.14);
    }
    h3 {
      width: 100%;
      color: #5b5751;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.35;
      text-align: center;
      white-space: nowrap;
    }
  }
</style>

<div>
  <img src={imgPath.src} alt="">
  <h3>{title}</h3>
</div>
