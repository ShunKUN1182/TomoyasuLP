---
const {imgPath,title} = Astro.props;
---

<style>
    div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
    align-items: center;
    min-width: 100px;
    img {
      width: 70px;
      height: 70px;
    }
    h3 {
      font-size: 16px;
    }
  }
</style>

<div>
  <img src={imgPath.src} alt="">
  <h3>{title}</h3>
</div>
