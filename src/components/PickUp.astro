---
import img01 from "../assets/pickup_items_img01.png";
import img02 from "../assets/pickup_items_img02.png";
import img03 from "../assets/pickup_items_img03.png";
import PickUPItem from "./PickUPItem.astro";

const pickupItemProps = [
  {
    imgPath: img01,
    title: "DIYスタイル",
  },
  {
    imgPath: img02,
    title: "ARAS",
  },
  {
    imgPath: img03,
    title: "ランタン",
  },

]
---

<style>
  .pickup_wrap {
    margin-top: -82px;
    position: relative;
    z-index: 2;
    h2 {
      height: 27px;
      width: 100%;
      background-color: var(--color-leaf);
      color: #fff;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0;
      line-height: 27px;
      padding: 0 32px;
    }
    .pickup_items {
      display: flex;
      margin: 22px 26px 0;
      justify-content: space-between;
      gap: 14px;
    }
  }

</style>

<div class="pickup_wrap">
  <h2>PICK UP</h2>
  <div class="pickup_items">
    {pickupItemProps.map((props)=>(
        <PickUPItem imgPath={props.imgPath} title={props.title}/>
    ))}
  </div>
</div>
