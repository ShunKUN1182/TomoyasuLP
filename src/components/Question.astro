---
import questionImg01 from "../assets/question_img01.png"
---

<style>
  .text_wrap {
    display: flex;
    flex-direction: column;
    margin: 28px 24px 0;
    gap: 8px;
    p {
      color: #a19482;
      font-size: 12px;
      font-weight: 700;
    }
    h3 {
      color: var(--color-ink);
      font-size: 18px;
      font-weight: 700;
      line-height: 1.45;
    }
  }

  .grid_imgs {
    margin: 28px 20px 44px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    img {
      width: 100%;
      height: 100%;
      aspect-ratio: 168 / 98;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: var(--shadow-soft);
    }
  }
</style>

<div class="text_wrap">
  <p>あなたの暮らし方</p>
  <h3>休日の過ごし方を教えて下さい</h3>
</div>

<div class="grid_imgs">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
</div>
