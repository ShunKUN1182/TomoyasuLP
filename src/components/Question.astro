---
import questionImg01 from "../assets/question_img01.png"
---

<style>
  .text_wrap {
    display: flex;
    flex-direction: column;
    margin-top: 32px;
    margin-left: 24px;
    gap: 10px;
    p {
      font-size: 12px;
    }
    h3 {
      font-size: 16px;
    }
  }

  .grid_imgs {
    margin: 32px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 15px;
    img {
      width: 100%;
      height: 100%;
    }
  }
</style>

<div class="text_wrap">
  <p>あなたの暮らし方</p>
  <h3>休日の過ごし方を教えて下さい</h3>
</div>

<div class="grid_imgs">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
  <img src={questionImg01.src} alt="">
</div>